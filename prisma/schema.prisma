generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CUSTOM_DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 Role                  @default(STUDENT)
  isApproved           Boolean               @default(false)
  isDemo               Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  studentType          StudentType           @default(ONLINE)
  level                Level                 @default(BASIC)
  accounts             Account[]
  comments             Comment[]
  courses              Course[]
  enrollments          Enrollment[]
  homeworkSubmissions  HomeworkSubmission[]
  notifications        Notification[]
  progress             Progress[]
  sessions             Session[]
  attempts             StudentAttempt[]
  tests                Test[]
  videoAssets          VideoAsset[]
  classId              String?
  studyClass           StudyClass?           @relation(fields: [classId], references: [id])
  leaderboardSnapshots LeaderboardSnapshot[]
  pointLedger          PointLedger[]
  pointWallet          PointWallet?
  redemptions          Redemption[]
  giftCodeUses         GiftCodeUse[]
  items                UserItem[]
  avatar               UserAvatar?
  gachaPulls           GachaPull[]

  @@index([classId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
}

model Course {
  id           String       @id @default(cuid())
  userId       String
  title        String
  description  String?
  thumbnail    String?
  price        Float?
  examDate     DateTime?
  isPublished  Boolean      @default(false)
  isStructured Boolean      @default(true)
  categoryId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  level        Level        @default(BASIC)
  attachments  Attachment[]
  chapters     Chapter[]
  category     Category?    @relation(fields: [categoryId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  finalTest    Test?        @relation("CourseFinalTest")
  classes      StudyClass[]

  @@index([categoryId])
}

model Chapter {
  id          String   @id @default(cuid())
  title       String
  description String?
  position    Int      @default(0)
  isPublished Boolean  @default(false)
  isHidden    Boolean  @default(false)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId])
}

model Lesson {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  videoUrl            String?
  position            Int                  @default(0)
  isPublished         Boolean              @default(false)
  isFree              Boolean              @default(false)
  type                LessonType           @default(VIDEO)
  muxData             String?
  duration            Int?
  chapterId           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  hasHomework         Boolean              @default(false)
  homeworkVideoUrl    String?
  attachments         Attachment[]
  comments            Comment[]
  homeworkSubmissions HomeworkSubmission[]
  chapter             Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress            Progress[]
  test                Test?

  @@index([chapterId])
}

model HomeworkSubmission {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  attachments Json[]
  status      HomeworkStatus @default(PENDING)
  feedback    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  courseId  String?
  lessonId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([lessonId])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  watchedTime Int      @default(0)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  isEdited  Boolean   @default(false)
  userId    String
  lessonId  String
  parentId  String?
  images    String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([userId])
  @@index([parentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  status    EnrollmentStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model VideoAsset {
  id        String   @id @default(cuid())
  fileName  String   @unique
  title     String
  url       String
  size      BigInt
  status    String   @default("READY")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Test {
  id              String           @id @default(cuid())
  title           String?
  subject         String?
  description     String?
  passScore       Float?
  accessCode      String?
  userId          String?
  lessonId        String?          @unique
  courseId        String?          @unique
  pdfUrl          String
  duration        Int
  showAnswers     Boolean          @default(false)
  type            TestType         @default(HOMEWORK)
  explanation     String?
  videoUrl        String?
  audioUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dueDate         DateTime?
  solutionVideos  Json?
  /// Vị trí lời giải từng câu trong PDF lời giải (xem lib/pdf-question-anchors.ts)
  solutionAnchors Json?
  attempts        StudentAttempt[]
  course          Course?          @relation("CourseFinalTest", fields: [courseId], references: [id], onDelete: Cascade)
  lesson          Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections        TestSection[]
  /// Hạn nộp riêng theo lớp (không có dòng → dùng dueDate chung)
  deadlines       TestDeadline[]
}

model TestSection {
  id        String     @id @default(cuid())
  testId    String
  name      String
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model Question {
  id                 String          @id @default(cuid())
  sectionId          String
  position           Int             @default(0)
  type               QuestionType    @default(MULTIPLE_CHOICE)
  correctAnswer      String?
  points             Float           @default(1.0)
  explanation        String?
  videoUrl           String?
  audioUrl           String?
  needsManualGrading Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  category           String?
  difficulty         String          @default("Medium")
  subCategory        String?
  section            TestSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  studentAnswers     StudentAnswer[]
  subQuestions       SubQuestion[]

  @@index([sectionId])
}

model StudentAttempt {
  id          String          @id @default(cuid())
  userId      String
  testId      String
  score       Float?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  answers     StudentAnswer[]
  test        Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
}

model StudentAnswer {
  id             String             @id @default(cuid())
  attemptId      String
  questionId     String
  answerProvided String?
  isCorrect      Boolean?
  pointsAwarded  Float              @default(0)
  feedback       String?
  attempt        StudentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  subAnswers     StudentSubAnswer[]

  @@unique([attemptId, questionId])
}

model SubQuestion {
  id            String          @id @default(cuid())
  questionId    String
  content       String?
  correctAnswer String
  type          SubQuestionType @default(TRUE_FALSE)
  position      Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  question          Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentSubAnswers StudentSubAnswer[]

  @@index([questionId])
}

model StudentSubAnswer {
  id              String   @id @default(cuid())
  studentAnswerId String
  subQuestionId   String
  answerProvided  String?
  isCorrect       Boolean?

  studentAnswer StudentAnswer @relation(fields: [studentAnswerId], references: [id], onDelete: Cascade)
  subQuestion   SubQuestion   @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)

  @@unique([studentAnswerId, subQuestionId])
  @@index([studentAnswerId])
}

enum Role {
  ADMIN
  STUDENT
  TEACHER
}

enum StudentType {
  ONLINE
  OFFLINE
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum LessonType {
  VIDEO
  DOCUMENT
  QUIZ
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
  TRUE_FALSE
  MULTIPLE_CHOICE_GROUP
}

enum SubQuestionType {
  TRUE_FALSE
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

enum HomeworkStatus {
  PENDING
  SATISFACTORY
  UNSATISFACTORY
}

enum NotificationType {
  COMMENT
  REPLY
  SYSTEM
}

enum Level {
  BASIC
  ADVANCED
}

enum TestType {
  HOMEWORK
  EXAM
}

model StudyClass {
  id                   String                @id @default(cuid())
  name                 String                @unique
  /// Khối 10 / 11 / 12 — "server" của Bảng Vàng
  grade                Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  users                User[]
  courses              Course[]
  leaderboardSnapshots LeaderboardSnapshot[]
  rewards              Reward[]
  deadlines            TestDeadline[]
  giftCodes            GiftCode[]
}

/// Hạn nộp riêng của một đề cho một lớp
model TestDeadline {
  id         String     @id @default(cuid())
  testId     String
  classId    String
  dueDate    DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  test       Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  studyClass StudyClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([testId, classId])
  @@index([classId])
}

model LeaderboardSnapshot {
  id           String @id @default(cuid())
  userId       String
  studyClassId String
  periodCode   String
  snapshotType String @default("WEEKLY")

  score          Float
  rankingScore   Float
  completedTests Int
  rank           Int?

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyClass StudyClass @relation(fields: [studyClassId], references: [id], onDelete: Cascade)

  @@unique([userId, periodCode, snapshotType])
  @@index([studyClassId, periodCode])
  @@index([userId])
  @@index([studyClassId])
}

// ===================== Điểm thưởng & đổi quà (lib/points) =====================

enum PointSource {
  TEST_SUBMIT
  TEST_SCORE
  BREAKTHROUGH
  FINAL_TEST
  HOMEWORK_SUBMIT
  HOMEWORK_PASS
  STREAK
  MANUAL
  REDEEM
  REFUND
  REVOKE
  ON_TIME
  GIFTCODE
  GACHA
  ITEM
}

/// Loại tiền: Xu (học mà có) và Ngọc (mã quà tặng thầy phát)
enum Currency {
  XU
  GEM
}

enum ItemSource {
  SHOP
  GACHA
  GIFT
}

enum RewardKind {
  PHYSICAL
  VIRTUAL
}

enum RedemptionStatus {
  PENDING
  DELIVERED
  CANCELLED
  REJECTED
  EXPIRED
}

/// Sổ điểm thưởng: mỗi dòng là một lần cộng (+) hoặc trừ (-). Không sửa/xoá dòng cũ.
model PointLedger {
  id          String      @id @default(cuid())
  userId      String
  amount      Int
  source      PointSource
  /// Khoá logic chống cộng trùng (vd "TEST:{testId}"): chỉ cộng khi tổng các dòng cùng khoá = 0
  key         String?
  /// Bài làm / bài nộp / yêu cầu đổi quà liên quan
  refId       String?
  reason      String?
  /// Giáo viên thực hiện (thưởng tay, từ chối quà…)
  createdById String?
  currency    Currency    @default(XU)
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, key])
  @@index([refId])
}

/// Số dư tính sẵn, luôn cập nhật cùng giao dịch với PointLedger (khoá dòng FOR UPDATE).
model PointWallet {
  userId         String   @id
  balance        Int      @default(0)
  /// Tổng điểm đã kiếm (không giảm khi đổi quà)
  lifetimeEarned Int      @default(0)
  weekStreak     Int      @default(0)
  bestWeekStreak Int      @default(0)
  /// Mã tuần (giờ VN, vd "2026-W47") gần nhất được tính vào chuỗi
  lastStreakWeek String?
  streakFreezes  Int      @default(1)
  goalRewardId   String?
  /// Ngọc (tiền hiếm) — bất biến: gems = tổng các dòng sổ currency = GEM
  gems           Int      @default(0)
  /// Số lượt Rương Xu liên tiếp chưa ra Sử thi+ (bảo hiểm gacha)
  gachaPity      Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Mã quà tặng (thẻ cào) thầy phát
model GiftCode {
  id          String        @id @default(cuid())
  code        String        @unique
  currency    Currency      @default(GEM)
  amount      Int
  /// 1 = thẻ cào cá nhân; N = mã dùng chung cả lớp
  maxUses     Int           @default(1)
  usedCount   Int           @default(0)
  expiresAt   DateTime?
  /// Chỉ học sinh lớp này nhập được (null = mọi lớp)
  classId     String?
  note        String?
  /// Các mã tạo cùng một lô
  batchId     String?
  isActive    Boolean       @default(true)
  createdById String
  createdAt   DateTime      @default(now())
  studyClass  StudyClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  uses        GiftCodeUse[]

  @@index([batchId])
  @@index([createdById, createdAt])
}

model GiftCodeUse {
  id         String   @id @default(cuid())
  giftCodeId String
  userId     String
  createdAt  DateTime @default(now())
  giftCode   GiftCode @relation(fields: [giftCodeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giftCodeId, userId])
  @@index([userId])
}

/// Đồ trang trí học sinh sở hữu (itemId = slug trong lib/game/items.ts)
model UserItem {
  id        String     @id @default(cuid())
  userId    String
  itemId    String
  source    ItemSource @default(SHOP)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

/// Nhân vật chibi: món đang trang bị ở từng ô
model UserAvatar {
  userId    String   @id
  config    Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Một lượt mở rương (kết quả tính ở server)
model GachaPull {
  id         String   @id @default(cuid())
  userId     String
  chest      String
  currency   Currency
  cost       Int
  outcome    Json
  pityBefore Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Reward {
  id                     String       @id @default(cuid())
  title                  String
  description            String?
  emoji                  String?
  imageUrl               String?
  price                  Int
  /// null = không giới hạn
  stock                  Int?
  /// Số lần mỗi học sinh được đổi trong một tháng; null = không giới hạn
  perStudentMonthlyLimit Int?
  kind                   RewardKind   @default(PHYSICAL)
  /// Quà hiện vật nhận tại lớp → chỉ học sinh OFFLINE thấy
  offlineOnly            Boolean      @default(true)
  /// Chi phí thật (VNĐ) để thống kê
  costVnd                Int?
  isActive               Boolean      @default(true)
  deletedAt              DateTime?
  createdById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  /// Rỗng = mọi lớp
  classes                StudyClass[]
  redemptions            Redemption[]
}

model Redemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  /// Giá lúc đổi (giáo viên đổi giá sau không ảnh hưởng)
  price       Int
  status      RedemptionStatus @default(PENDING)
  note        String?
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      Reward           @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@index([rewardId])
}
