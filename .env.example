# Mẫu biến môi trường — copy thành .env rồi điền giá trị thật.
# KHÔNG commit file .env chứa giá trị thật.

# --- Database ---
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
CUSTOM_DATABASE_URL=

# --- Auth (NextAuth) ---
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Backblaze B2 / CDN ---
B2_KEY_ID=
B2_APP_KEY=
B2_REGION=
B2_ENDPOINT=
B2_BUCKET_NAME=
NEXT_PUBLIC_VIDEO_DOMAIN=
NEXT_PUBLIC_S3_DOMAIN=
